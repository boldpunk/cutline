# PostgreSQL connection string
DATABASE_URL=postgres://cutline:cutline@localhost:5432/cutline

# Public base URL (used for private booking links, sitemap, emails). No trailing slash.
APP_URL=http://localhost:3000

# 32+ random characters. Signs client access grants and seals idempotent replies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=change-me-to-a-long-random-string-change-me

# Send cookies with the Secure flag. Keep "true" behind HTTPS; "false" only for plain-http local testing.
COOKIE_SECURE=false

# Trust X-Forwarded-For for rate limiting (only behind your own reverse proxy).
TRUST_PROXY=false

# --- Optional e-mail notifications -------------------------------------------
# Leave SMTP_HOST empty to disable e-mail entirely. When disabled, the booking
# form doesn't ask for an e-mail and the site never promises one.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CUTLINE <no-reply@example.com>"
# Hours before the visit to send an e-mail reminder (0 disables reminders).
REMINDER_HOURS_BEFORE=24
